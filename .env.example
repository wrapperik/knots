# Frontend (exposed to the browser, safe to share)
# Find these in Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions (server-side secrets, never prefix with VITE_)
# Set them with: npx supabase secrets set OPENROUTER_API_KEY=...
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=a-free-model-id
