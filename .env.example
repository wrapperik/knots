# Frontend (exposed to the browser, safe to share)
# Locally: the API URL and publishable key printed by `npx supabase start`
# Live: Supabase, Project Settings > API
# Never use the secret key here: it bypasses Row Level Security
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge Functions (server-side secrets, never prefix with VITE_)
# Locally: copy these into supabase/functions/.env (ignored by Git)
# Live: npx supabase secrets set OPENROUTER_API_KEY=... OPENROUTER_MODEL=...
OPENROUTER_API_KEY=your-openrouter-key
# One model id, or several separated by commas: the next is tried when one is busy
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
# Optional: another address for the chat completions API, such as a mock in tests
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
